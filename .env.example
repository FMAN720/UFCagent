# Copy to .dev.vars for local Cloudflare/Vinext development; never commit keys.
# Public-data and matchup modes work without a model key.
UFC_MODEL_API_KEY=
UFC_MODEL_BASE_URL=https://api.openai.com/v1
UFC_MODEL_PROTOCOL=responses
UFC_MODEL_NAME=gpt-5-mini
# For another compatible provider: set its HTTPS /v1 base URL, model ID,
# and UFC_MODEL_PROTOCOL=chat. Only enable models supporting tool calls.
